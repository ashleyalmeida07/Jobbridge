PROJECT_NAME=JobBridge
TARGET_COUNTRY=US

# Database URL for Neon DB (postgres:// or postgresql://)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Security / Auth
SECRET_KEY=generate-a-secure-random-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 1 week

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Fernet Key for encrypting tokens (generate with `from cryptography.fernet import Fernet; Fernet.generate_key()`)
FERNET_KEY=your-fernet-key-here

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Scraper Configuration
SCRAPER_DELAY_SECONDS=5
USER_AGENT=JobBridge Scraper/1.0
SCRAPER_ADMIN_KEY=secret-admin-key
